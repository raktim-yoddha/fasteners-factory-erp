    "@fasteners/ui-web": "workspace:*",
    "@fasteners/cloud-repository": "workspace:*",
    "better-sqlite3": "13.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "7.18.4",
    "@tanstack/react-query": "5.104.2",
    "zod": "4.6.7",
    "@fasteners/client-storage": "workspace:*"
